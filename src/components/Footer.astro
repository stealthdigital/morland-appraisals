---
const LOGO =
  'https://res.cloudinary.com/dj76bnpni/image/upload/c_crop,w_378,h_72,x_4,y_4/f_auto,q_auto,w_756/v1788982277/morland-appraisals-logo-dark_phj6wc.jpg';
const aic = (w: number) =>
  `https://res.cloudinary.com/dj76bnpni/image/upload/f_auto,q_auto,w_${w}/v1788982278/appraisal-institute-of-canada-logo_phh8tr.png`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/"><img src={LOGO} alt="Morland Real Estate Appraisals" width="386" height="80" /></a>
      <p>A full service professional appraisal company approved and licensed by the Appraisal Institute of Canada, serving North Bay and Northeastern Ontario for over 30 years.</p>
    </div>
    <div>
      <h3>Contact</h3>
      <address>
        <span>382 Fraser Street<br />North Bay, ON P1B 3W7</span>
        <a href="tel:+17054743500">(705) 474-3500</a>
        <a href="mailto:info@morlandappraisals.org">info@morlandappraisals.org</a>
        <span>Monday to Friday, 9 am to 5 pm</span>
      </address>
    </div>
    <div>
      <h3>Pages</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/residential-appraisals">Residential Appraisals</a></li>
        <li><a href="/commercial-appraisals">Commercial Appraisals</a></li>
        <li><a href="/hunting-fishing-lodge-appraisals">Hunting &amp; Fishing Lodge Appraisals</a></li>
        <li><a href="/ontario-golf-course-appraisals">Golf Course Appraisals</a></li>
        <li><a href="/service-area">Service Area</a></li>
        <li><a href="/sudbury-property-appraisals">Sudbury Appraisals</a></li>
        <li><a href="/warren-property-appraisals">Warren Appraisals</a></li>
        <li><a href="/about-us">About Us</a></li>
        <li><a href="/about-us#team">Our Team</a></li>
        <li><a href="/contact-us">Contact Us</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-aic">
    <div class="aic-card"><img src={aic(440)} srcset={`${aic(220)} 220w, ${aic(440)} 440w`} sizes="220px" alt="Appraisal Institute of Canada" width="3213" height="558" loading="lazy" /></div>
    <p>Approved and licensed by the Appraisal Institute of Canada.</p>
  </div>
  <div class="footer-legal">
    <div class="container">
      <span>&copy; 2026 Morland Real Estate Appraisals Ltd. All rights reserved.</span>
      <span>382 Fraser Street, North Bay, Ontario</span>
    </div>
  </div>
</footer>
