---
interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
/* Cloudinary URLs carry their transform right after /upload/; rewrite the width per breakpoint. */
const at = (w: number) => image.replace(/\/upload\/([^/]*\/)?(?=v\d+\/)/, (_m, t = '') => `/upload/${t.replace(/w_\d+/, `w_${w}`)}`);
const srcset = [768, 1280, 1920].map((w) => `${at(w)} ${w}w`).join(', ');
---

<section class="photo-band">
  <img src={at(1920)} srcset={srcset} sizes="100vw" alt={alt} loading="lazy" />
</section>
