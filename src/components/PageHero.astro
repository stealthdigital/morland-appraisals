---
interface Props {
  image: string;
  alt: string;
  title: string;
  lede: string;
}

const { image, alt, title, lede } = Astro.props;
/* Cloudinary URLs carry their transform right after /upload/; rewrite the width per breakpoint. */
const at = (w: number) => image.replace(/\/upload\/([^/]*\/)?(?=v\d+\/)/, (_m, t = '') => `/upload/${t.replace(/w_\d+/, `w_${w}`)}`);
const srcset = [768, 1280, 1920].map((w) => `${at(w)} ${w}w`).join(', ');
---

<section class="hero hero--page">
  <img class="hero-bg" src={at(1920)} srcset={srcset} sizes="100vw" alt={alt} fetchpriority="high" />
  <div class="container">
    <div class="hero-copy">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </div>
  </div>
</section>
