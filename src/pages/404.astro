---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Morland Real Estate Appraisals"
  description="The page you were looking for could not be found."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="section">
    <div class="container thanks">
      <div class="rule"></div>
      <h1>Page not found.</h1>
      <p class="lede">The page you were looking for has moved or no longer exists. Try one of the links below, or call us at <a href="tel:+17054743500">(705) 474-3500</a>.</p>
      <div class="btn-group">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/contact-us">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
