---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank You | Morland Real Estate Appraisals"
  description="Your appraisal request has been sent to Morland Real Estate Appraisals."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="section">
    <div class="container thanks">
      <div class="rule"></div>
      <h1>Thank you.</h1>
      <p class="lede">Your request has been sent. One of our qualified appraisers will be in touch shortly. If it's urgent, call us at <a href="tel:+17054743500">(705) 474-3500</a>, Monday to Friday, 9 am to 5 pm.</p>
      <div class="btn-group">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/residential-appraisals">Our services</a>
      </div>
    </div>
  </section>
</BaseLayout>
